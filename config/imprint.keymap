#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    macros {
        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp C>, <&macro_release &kp LCTRL>;
        };
        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp V>, <&macro_release &kp LCTRL>;
        };
        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp X>, <&macro_release &kp LCTRL>;
        };
        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp Z>, <&macro_release &kp LCTRL>;
        };
        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp Y>, <&macro_release &kp LCTRL>;
        };
        lang: lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp LSHFT>, <&macro_release &kp LALT>;
        };
    };

    behaviors {
        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };
        td_layer: tap_dance_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 1>, <&to 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
         default_layer {
            bindings = <
&trans   &kp F1  &kp F2    &kp F3    &kp F4    &kp F5                     &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH    &kp DOLLAR    &kp PERCENT       &kp LBKT     &kp RBKT    &kp SQT     &kp LEFT_PARENTHESIS    &kp N0    &kp EQUAL
&kp ESC    &kp Q   &kp W     &kp E     &kp R     &kp T                      &kp Y      &kp U     &kp I      &kp O     &trans  &trans
&kp TAB   &kp A   &kp S     &kp D     &kp F     &kp G                      &kp H      &kp J     &kp K      &kp L     &kp P     &kp FSLH
&kp LCTRL  &td_caps   &kp X     &kp C     &kp V     &kp B                      &kp N      &kp M     &kp COMMA  &kp DOT   &kp SEMI  &td_caps
&trans     &trans  &kp Z   &trans    &mkp LCLK                                       &kp CARET   &kp AMPERSAND   &kp STAR  &kp PAGE_UP    &kp PAGE_DOWN      
                                       &kp LALT   &kp LGUI &kp BSLH     &kp MINUS  &kp BSPC   &trans
                                        &kp SPACE  &mo 1 &kp GRAVE      &kp EQUAL  &mo 1 &kp RET
            >;
        };
        commands_layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4               &rgb_ug RGB_COLOR_HSB(60,40,50)   &rgb_ug RGB_BRI    &rgb_ug RGB_TOG     &rgb_ug RGB_BRD     &trans     &lang
&trans  &trans  &trans  &trans  &trans  &trans                                                  &trans      &undo        &trans     &kp RIGHT_PARENTHESIS     &trans     &trans
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                                                  &trans        &kp RA(U)       &kp UP     &kp RA(O)  &trans     &trans
&trans  &kp RA(A)  &kp N4  &kp N5  &kp N6  &trans                                               &trans     &kp LEFT     &kp DOWN   &kp RIGHT   &trans     &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &kp RA(S)                                               &trans     &cut         &copy     &paste     &trans     &trans
&trans  &trans  &trans  &kp N0  &trans                                                          &trans     &trans       &trans      &trans     &trans
                                    &trans  &trans  &trans                              &trans  &kp DELETE    &trans
                                    &trans  &trans  &trans                               &trans  &trans   &trans
            >;
        };
    };
};

// right hand trackball configuration

// &trackball_peripheral_listener {
//    input-processors =
//     activate layer 3 within 500ms of the trackball moving
//     <&zip_temp_layer 3 500>;
// };

//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),
        <&zip_xy_scaler 1 20>,
        // make this trackball output scrolling events by default instead of cursor movement,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
